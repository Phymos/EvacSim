# Virtualenv
.venv/

# Python bytecode
__pycache__/
*.pyc

# API keys, credentials, auth material - NEVER commit these
.env
*.env
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
*-key.json
auth/

# Other VCS / workspace admin stores - do not scoop into git
.hg/
.sl/
.eden/

# Unity project (unity/EvacSim): ignore generated/local dirs and files.
# Assets/, Packages/ and ProjectSettings/ are intentionally tracked.
unity/EvacSim/Library/
unity/EvacSim/Temp/
unity/EvacSim/Obj/
unity/EvacSim/Logs/
unity/EvacSim/UserSettings/
unity/EvacSim/Build/
unity/EvacSim/*.csproj
unity/EvacSim/*.sln
